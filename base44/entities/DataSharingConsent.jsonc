{
  "name": "DataSharingConsent",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "current_question",
        "anonymous_context",
        "location",
        "conversation",
        "journal",
        "performance_metrics",
        "images",
        "voice"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "oracle",
        "web",
        "news",
        "weather",
        "updates",
        "community",
        "external_ai",
        "custom_api",
        "sync",
        "tools"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "duration": {
      "type": "string",
      "enum": [
        "once",
        "one_hour",
        "today",
        "until_revoked",
        "permanent"
      ],
      "default": "until_revoked"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed": {
      "type": "boolean",
      "default": false
    },
    "granted": {
      "type": "boolean",
      "default": false
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
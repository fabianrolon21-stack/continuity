{
  "name": "BisonActivity",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "TASK_COMPLETED",
        "TASK_WAITING",
        "TASK_FAILED",
        "GOAL_CREATED",
        "GOAL_COMPLETED",
        "PERMISSION_REQUIRED",
        "INSIGHT"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}